%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene24
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Where did you all run off to?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: We had to hide ourselves when we sensed Richard approaching.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: We sensed some overwhelming presence coming from him.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Well, Mr. Miller definitely knows something about what we\u2019ve
      been doing, and seemed to be threatening me."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I can\u2019t believe it. Was he the one\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Unfortunately so, D\xE9sir\xE9."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: He was our killer.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Our what??
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Are you saying you knew this the whole time?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I\u2019m sorry for keeping this from you all, but, well, people don\u2019t
      just become ghosts for no reason."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "There\u2019s always a reason for ghosts to linger. Our reason is unfortunately
      we were murdered."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "That explains our suspicious deaths. Circus life is always dangerous
      but something about our \u201Caccidents\u201D seemed strange."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "It\u2019s all coming back to me now\u2026 He\u2019s telling the truth\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: So what are we going to do? Are we going to confront Mr. Miller?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "You should get some rest, dear friend, and leave the planning to us.
      The night won\u2019t last much longer, after all."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: But-
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "D\xE9sir\xE9 is right. Get some sleep for now and we can figure out
      what to do tomorrow."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: We have a lot to discuss between ourselves.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: If I can even fall asleep after hearing all this, that would be amazing.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Good night\u2026"
    dialogueOptions: []
