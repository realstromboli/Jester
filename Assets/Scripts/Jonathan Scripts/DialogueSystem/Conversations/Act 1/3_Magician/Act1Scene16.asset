  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene16
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 24d7ff1d07f4c974bab6fd5d0e8ec1ab, type: 3}
    dialogue: So what do you remember?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 09bbaa10d60de1147bcc1515c33cb636, type: 3}
    dialogue: It is a tragedy! I died during my own performance, drowning in my water
      tank!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 61513245f94104545b999cdb0e1e744e, type: 3}
    dialogue: "Oh no, that\u2019s horrific!"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: b60054af34f22ea488f05de5a89dc32c, type: 3}
    dialogue: "I was locked in, ready to perform my daring escape for the first time,
      when suddenly, I couldn\u2019t get out!"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: bb1fd0f5324e09f42bc3a31deefa122e, type: 3}
    dialogue: Did you not have some sort of contingency plan?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: a58ba1e58f16ce941a566bafb4f6cef7, type: 3}
    dialogue: "I must\u2019ve, but I can\u2019t recall what went wrong with it."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 6d63049fbe4b954478f4ba8e50b4bba2, type: 3}
    dialogue: "Well, now what, Antonio? You\u2019ve been a bit quiet."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 2e4f86adb8923cb439a22d163e4395f6, type: 3}
    dialogue: "Sorry, I\u2019ve just been thinking."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 7fb58551625a11d48a137aefeb268a59, type: 3}
    dialogue: About what?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: d34bff7d572e12148a68e17831890765, type: 3}
    dialogue: "Well, I think it\u2019s about time I told you all something-"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: e8975ab83dc749a449e6a092418e3c8c, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 60e41c0e7caa2dd4fb52f69d42c6e3ce, type: 3}
    dialogue: '                                                                                            '
    dialogueOptions: []
