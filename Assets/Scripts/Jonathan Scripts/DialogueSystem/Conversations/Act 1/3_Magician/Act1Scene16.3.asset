%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene16.3
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Ah, welcome, ladies and gentleman! I am The Magnificent Montague, at
      your service!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Ah, I see now\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Antonio, my dear boy! How are you doing?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I\u2019m doing as well as I can be. Thankfully we have not lost ourselves
      thanks to our friend here."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Ah, yes, of course.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Thank you, dear friend, for bringing me back to my senses. I hope I
      can repay you for your generosity!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Well, are you able to tell me a bit about yourself?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: For many years I was one of the best performers at this circus, enchanting
      all with my tricks!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Do you remember how you died perchance?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I\u2019m sorry, my dear friend, but unfortunately I cannot recall."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Would the poster allow me to enter the ghost world? We could get his
      memories back as well.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Yes, that should work well as a doorway. D\xE9sir\xE9, please attach
      yourself to the mask before we leave."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Of course, dear Antonio. I will gladly grace you all with my presence!
    dialogueOptions: []
