  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene15.2
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: f923544c17c391648b27b4bc90ef8f46, type: 3}
    dialogue: You seem to know a lot about Antonio. Were you at the circus before
      he died?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 1473160cae832bf40b27ca716c3dd3a7, type: 3}
    dialogue: Yes, my friend, I was one of the first performers at the circus. I
      love performance and putting on a good show!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 236d4c2dd14812341bbd09fd8de54c1e, type: 3}
    dialogue: "I can tell\u2026 Did you love performing at the circus?"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 484ee223d9a4e2a43a55343519db6341, type: 3}
    dialogue: Yes, but despite my love for the circus, it was always my dream to
      move on from it and have my own theater, but alas, that day never came.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: d2b2c7edeff13c1468349b583afd1d35, type: 3}
    dialogue: Sorry to hear that.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: c13485d5547e28049b2332b4a091aa4d, type: 3}
    dialogue: "Don\u2019t be, you did nothing wrong, my friend."
    dialogueOptions: []
