--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene13.3
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 8c2632ca5b6b5664fb4055d4839c81ca, type: 3}
    dialogue: Ah, welcome, ladies and gentleman! I am The Magnificent Montague, at
      your service!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: ced2eba253d63fb4b9b00a2e4490c878, type: 3}
    dialogue: "Ah, I see now\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 8b8ddeb922fc5634f9c012487a0214b5, type: 3}
    dialogue: Antonio, my dear boy! How are you doing?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 313e7844ec73ae04b862b504072db0d0, type: 3}
    dialogue: "I\u2019m doing as well as I can be. Thankfully we have not lost ourselves
      thanks to our friend here."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 4982351a4d9522745bee6ccd70f28bf3, type: 3}
    dialogue: Thank you, dear friend, for bringing me back to my senses. I hope I
      can repay you for your generosity!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: ae1a69e75ab831c46a43f79dd3370043, type: 3}
    dialogue: Well, are you able to tell me a bit about yourself?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 47f0d3bd6aa9d5149a1964e1f6fdf3d1, type: 3}
    dialogue: For many years I was one of the best performers at this circus, enchanting
      all with my tricks! Unfortunately, I cannot recall my death, however.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: dcf435a5d194b2f42a84a5028006f905, type: 3}
    dialogue: Would the poster allow me to enter the ghost world? We could get his
      memories back as well.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 1978f8b3ef9a8cf429b2ec98187910e6, type: 3}
    dialogue: "Yes, that should work well as a doorway. D\xE9sir\xE9, please attach
      yourself to the mask before we leave."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 271855a0698699a4d97673af62310339, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 39131ecb45474b943b4f9f205d4661aa, type: 3}
    dialogue: Of course, dear Antonio. I will gladly grace you all with my presence!
    dialogueOptions: []
