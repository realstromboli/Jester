  allLines:
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "That\u2019s the item! It\u2019s the net they use in the circus."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 96ef444a6cfd5ef4f812b8eb996fc3fc, type: 3}
    dialogue: So how are we going to get down to it?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: We jump, of course.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I\u2019ll be with you on the way down, so you don\u2019t have to be
      afraid of going alone."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 02379de1bf32f374c9c776a6bc26108f, type: 3}
    dialogue: I guess I have no choice. Let's go!
    dialogueOptions: []
