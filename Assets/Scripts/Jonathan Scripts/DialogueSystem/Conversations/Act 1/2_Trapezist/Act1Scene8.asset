  allLines:
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: f15c160e0034f5a45b555acf2ad710af, type: 3}
    dialogue: Welcome back to the ghost world.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: c392b2ac423c9a14c91f35f22b24a824, type: 3}
    dialogue: "Oh, I wasn\u2019t serious about holding your breath."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 063922aea999a664f8f16f5a52bfe69b, type: 3}
    dialogue: "\u2026 Not funny\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 5de3036fdf2a3d44998d1f17e98cba6c, type: 3}
    dialogue: So what do we do? How do we get my memories back?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 8760ec735f5089848a456f9b3ef4debb, type: 3}
    dialogue: Somewhere in here will be your lost memories, represented by an important
      item relating to them.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 16f91e2f6437d0b46850f4e4564a53eb, type: 3}
    dialogue: "We\u2019re trying to act quickly, so it won\u2019t be a perfect restoration,
      but it should help us start recovering your memories."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: e45639dba50862641963890747dd665c, type: 3}
    dialogue: "Alright, let\u2019s do this!"
    dialogueOptions: []
