%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene7.3
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Oh, hello\u2026 You\u2019re the one that helped me, yeah? Um, thank
      you for that."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 82900d2c1f477144fbc0ff8b3dea307f, type: 3}
    dialogue: No problem. Would you be able to tell me about yourself?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: Uh, I remember my name is Lottie and I used to be a trapezist at this
      circus.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: I left home to find some freedom, and Mr. Miller was kind enough to
      give me a job here. I can't remember how I died though.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 6e0ef02a42baa3348a109f30356f4356, type: 3}
    dialogue: Is there a way to restore her memory?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: d46b697d38ce797408fc5430790c8079, type: 3}
    dialogue: "There is a quick way to restore pieces of memories, but we\u2019d
      have to ask you for help again. If you\u2019re really set on helping, I can
      direct you on how to do it."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: ec568c82ee3868a4ab812eebb706062d, type: 3}
    dialogue: Say, Lottie, could you try attaching yourself to the mask?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Sure\u2026"
    dialogueOptions: []
