MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene9.2
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 34b0f514e0da7464eac09bcf4c4004f9, type: 3}
    dialogue: Why did you run away from home, exactly?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 30feccb486f73b840bdab354ed5a28d0, type: 3}
    dialogue: "Huh? Oh, I don\u2019t know."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: ebb7e3d740bf4214ebe9da146476e06d, type: 3}
    dialogue: Sorry for asking.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 7632d35707adf3246bd82f5629ec7108, type: 3}
    dialogue: "No, it\u2019s okay. It was just that my parents had specific plans
      for my life, and I felt trapped by it all."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 3ed2e72c39477d24fbf0a19f80be2ed8, type: 3}
    dialogue: "My older sister always tried to back me up, but it just felt overbearing
      and overprotective and I just needed to get out. I miss her so much\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: e36dd9f4d7941724186d6716034744c0, type: 3}
    dialogue: Why did you join the circus?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 244eaba036f4e1d4b9d780a5e04c45ff, type: 3}
    dialogue: It just sort of happened. I stumbled into the circus and thought it
      looked fun. Thankfully Mr. Miller was kind enough to take me in and I started
      training with the trapezist, Ray.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 902f893978ab1d7479a2761b7b805757, type: 3}
    dialogue: "It must\u2019ve been rough for a while."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 0bdebcf1161cbfc4d9a7b71db56d570e, type: 3}
    dialogue: "Yeah, but I thought it was worth it. Until I died, that is\u2026"
    dialogueOptions: []
