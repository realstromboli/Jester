  allLines:
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Alright, head back to her photograph. We\u2019re going to attempt
      to enter the ghost world with you."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I\u2019m sorry, I\u2019m going to be going to the ghost world? Are
      you batty?"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Um, I\u2019m not sure what that means, but I assure you it is possible."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: And nothing will happen to me there, right?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "As long as we don\u2019t spend too much time there, there shouldn\u2019t
      be anything that will affect you negatively."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Great, that\u2019s reassuring."
    dialogueOptions: []
