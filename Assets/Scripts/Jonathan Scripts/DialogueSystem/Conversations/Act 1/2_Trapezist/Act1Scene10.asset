  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene10
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: b6119caa1778488429bfd4f1290683bf, type: 3}
    dialogue: I am never doing that again!
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Are you okay? You look like you\u2019ve seen a ghost."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 05633a9e3e301714dbea1450ddb99593, type: 3}
    dialogue: "You\u2019re insufferable\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I remember now\u2026 I fell from my fly bar onto the net, but it didn\u2019t
      break my fall\u2026 It broke under me."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: You will eventually regain more and more, but that was the best we
      could do for now.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: cc564a05d1f89d345ac11c2f7e890849, type: 3}
    dialogue: Are there any ghosts left?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "Yes, if we want to help them we\u2019d better do so quickly. They\u2019re
      in one of the rooms in the Big Top."
    dialogueOptions: []
