  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene9.1
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: af595521d1b59224eaf2e3fb71959ad1, type: 3}
    dialogue: "That\u2019s a high climb."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 10670849d565c0d469dfe7ddc84d68de, type: 3}
    dialogue: I can sense my memories up there.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 3b90733fff81ce94495e9a7fa079613a, type: 3}
    dialogue: "I was afraid you were going to say that\u2026 There has to be a way
      around!"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 954437a1cad75c34d9a5c97331cc3220, type: 3}
    dialogue: "I don\u2019t think that\u2019s an option\u2026 But I think you can
      get up with my power if you aim correctly."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: d664077a9b8358f4a93abc1df70c384f, type: 3}
    dialogue: "Um, I don\u2019t know if I\u2019m comfortable with that."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 03d12eaf97cd280478c0cd21cef38fc9, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 5c79505f1d515d34788b0143695e4546, type: 3}
    dialogue: You can do it, I believe in you! Just make sure to aim high and move
      as fast as possible through the air.
    dialogueOptions: []
