  allLines:
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 080bd6d958ca0f54aa8fcce5dcb7d07e, type: 3}
    dialogue: "Alright, We\u2019re going to attempt to enter the ghost world with
      you this time."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: e429ecd7c82fb5d4eb7fa4fce7270008, type: 3}
    dialogue: Was that the place from before? I almost died last time! Are you batty?
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: a47efc5135e9fa14ba7f4bd626bd67d9, type: 3}
    dialogue: "Um, I\u2019m not sure what that means, but I assure you it is the
      only way. With us there you will be able to use our powers, making it easier
      to survive."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 4f892b6742261fc4181215066a5f02e6, type: 3}
    dialogue: "Great, that\u2019s reassuring."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 1177d07ef5bc90940b46d75e998a48fe, type: 3}
    dialogue: Make sure to hold your breath!
    dialogueOptions: []
