--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265629390da5d048b9048e88bfa94cb, type: 3}
  m_Name: Act1Scene4.3
  m_EditorClassIdentifier: 
  allLines:
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: ee683d309313b8a469d5e4120c46c5ae, type: 3}
    dialogue: "Ah, I\u2019m back! Thank you! Good thing you knew what to do. I was
      lucky enough to assist you before I fully lost control.\r"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: e3a3c9a96956c9a4a93a47a96f3e97a1, type: 3}
    dialogue: "I think I\u2019m due some answers here.\r\r"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 8f2eacac68c25a647a96cc096570e8d3, type: 3}
    dialogue: "Yes, of course. My name is Antonio. I was the previous jester at this
      circus. It was like a home to me\u2026 And it is also my grave.\r\r\r"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 2505660c5a598c94ead80419cd40c3a5, type: 3}
    dialogue: You died here? Sorry to hear that.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: a0d2efdc46f56be4cb7d1c7c71cd3032, type: 3}
    dialogue: "Yes, it was unfortunate. My magic wasn\u2019t even enough to save
      me."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 049d76a84f2c1eb4c939a38a2311f4e7, type: 3}
    dialogue: "I was a magician, a real one. That\u2019s why the mask I gave you
      has special powers."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 0}
    dialogue: "I\u2019m sorry, this is a lot to take in\u2026"
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 646b75cf23888c2468d11996077a6489, type: 3}
    dialogue: Well we can talk more later, but I need to figure out how to help the
      others.
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: 87aeb4586b2c7154a8ad18806dcc400e, type: 2}
    dialogueAudio: {fileID: 8300000, guid: c75b0201eb2e92f4abb02f8efa8893b2, type: 3}
    dialogue: "There are other ghosts here? Maybe I can help out! I\u2019m clearly
      a professional ghost helper after all."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 50a2e3cc03a7bea4dab36652dbdfca84, type: 3}
    dialogue: "I guess you aren\u2019t going to take no for an answer\u2026 Alright,
      we can help them together."
    dialogueOptions: []
  - speaker: {fileID: 11400000, guid: a03a42448b39ea94a8d4dbe68b31d1b7, type: 2}
    dialogueAudio: {fileID: 8300000, guid: 558179d72c50e874d8dfd100caffcf3d, type: 3}
    dialogue: But before we leave, I can attach myself to the mask and give you more
      power. Just hold still.
    dialogueOptions: []
